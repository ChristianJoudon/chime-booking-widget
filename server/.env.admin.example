CHIME_DATABASE_URL=postgres://chime:chime@127.0.0.1:5534/chime
CHIME_ADMIN_PORT=8888
CHIME_ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:4373,http://localhost:4373,http://127.0.0.1:4374,http://localhost:4374

# Replace this value. It must contain at least 32 random characters.
CHIME_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
CHIME_CUSTOMER_APPROVAL_URL=http://127.0.0.1:4375/approval.html
CHIME_CUSTOMER_ACTION_TTL_HOURS=168

# Notification delivery is sandboxed unless both values explicitly enable live sending.
CHIME_NOTIFICATION_MODE=sandbox
CHIME_NOTIFICATIONS_LIVE=false
CHIME_NOTIFICATION_BATCH_SIZE=20
CHIME_NOTIFICATION_MAX_ATTEMPTS=5
CHIME_NOTIFICATION_POLL_MS=5000
CHIME_NOTIFICATION_LEASE_SECONDS=120

# Live email through Resend.
CHIME_RESEND_API_KEY=
CHIME_EMAIL_FROM=

# Live SMS through Twilio.
CHIME_TWILIO_ACCOUNT_SID=
CHIME_TWILIO_AUTH_TOKEN=
CHIME_TWILIO_FROM=

# Optional signed webhook delivery.
CHIME_NOTIFICATION_WEBHOOK_URL=
CHIME_NOTIFICATION_WEBHOOK_SECRET=

# IDs supplied by database/seed-admin-demo.sql.
CHIME_ADMIN_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
CHIME_ADMIN_USER_ID=00000000-0000-4000-8000-000000000101
CHIME_ADMIN_USER_EMAIL=owner@chime.local
CHIME_ADMIN_USER_ROLE=owner
CHIME_ADMIN_SESSION_HOURS=12
