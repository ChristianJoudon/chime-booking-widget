# Copy to config/admin/.env.local (NOT the repository root -- the root is read by
# every Vite config in the project, including the booking widget build).
VITE_CHIME_ADMIN_API_URL=http://127.0.0.1:8888/api/chime/admin

# Administrators sign in with a password; no token belongs here. Set a password
# with: cd server && npm run set-password
