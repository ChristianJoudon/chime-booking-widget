# Copy to .env.local for local demo data while developing.
# Demo data shows the simulated test-mode card form automatically — no Stripe keys needed.
# To test REAL card entry locally, set VITE_CHIME_STRIPE_PUBLISHABLE_KEY=pk_test_... and run the server.
VITE_CHIME_USE_DEMO_DATA=true
VITE_CHIME_CURRENCY=USD
