# Chime production configuration.
#
# Copy to .env.production and fill in. That file is gitignored and must never
# be committed. Every value here has a consequence a customer can see, so the
# comments say what goes wrong if it is set incorrectly.
#
# After filling this in, run `npm run preflight` before serving anyone. It
# refuses configurations that look live and are not.

# ---- database ---------------------------------------------------------------
POSTGRES_USER=chime
POSTGRES_PASSWORD=            # generate: openssl rand -base64 32
POSTGRES_DB=chime
POSTGRES_PORT=5535            # host side only; bound to 127.0.0.1

# Used by the application containers. The host is the compose service name.
CHIME_DATABASE_URL=postgres://chime:REPLACE_ME@database:5432/chime

# ---- ports (all bound to 127.0.0.1; put a TLS proxy in front) ----------------
CUSTOMER_API_PORT=8787
ADMIN_API_PORT=8788

# ---- sessions ---------------------------------------------------------------
# Signs administrator sessions. Changing it signs everyone out, which is the
# fastest way to end every session if a laptop goes missing.
# generate: openssl rand -hex 32
CHIME_ADMIN_SESSION_SECRET=

# Origins allowed to call the administrator API. No wildcards.
CHIME_ADMIN_ALLOWED_ORIGINS=https://studio.example.com

# ---- what kind of workspace this is -----------------------------------------
# demo | test | live. Only `live` takes real money and sends real messages, and
# the server refuses to start if `live` is contradicted by the settings below.
CHIME_WORKSPACE_ENV=demo

# Accepts demo payment identifiers as though they were real charges. Must be
# false in a live workspace; preflight fails if it is not.
CHIME_ALLOW_DEMO_PAYMENTS=true

# ---- payments ---------------------------------------------------------------
# sk_test_… charges nobody. sk_live_… charges real cards. A live workspace with
# a test key looks like it is collecting deposits and never collects one, so
# preflight treats that as a failure rather than a warning.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- messages ---------------------------------------------------------------
# sandbox records deliveries without sending. live actually sends.
CHIME_NOTIFICATION_MODE=sandbox
RESEND_API_KEY=
CHIME_NOTIFICATION_FROM_EMAIL=bookings@example.com

# SMS. Leave blank to send email only.
CHIME_SMS_ACCOUNT_SID=
CHIME_SMS_AUTH_TOKEN=
CHIME_SMS_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Stripe webhooks
# ---------------------------------------------------------------------------
# The signing secret Stripe shows when you create the endpoint. Until this is
# set, /api/chime/stripe/webhook answers 503 and the only thing telling this
# system a card succeeded is the customer's browser.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# Worker liveness
# ---------------------------------------------------------------------------
# The notification worker's health port. Bound to 0.0.0.0 inside the container
# so the health check can reach it; nothing publishes it outside the compose
# network. Changing the port here means changing it in the healthcheck too.
CHIME_WORKER_HEALTH_HOST=0.0.0.0
CHIME_WORKER_HEALTH_PORT=8889
