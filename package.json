{
  "name": "chime-standalone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.ts",
    "dev:approval": "vite --config vite.approval.config.ts",
    "build": "vite build",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:approval": "vite build --config vite.approval.config.ts",
    "preview": "vite preview",
    "test:admin-api": "node scripts/admin-api-smoke.mjs",
    "test:customer-approval": "node scripts/customer-approval-smoke.mjs",
    "test:notifications": "node scripts/notification-delivery-smoke.mjs",
    "test:customers": "node scripts/customer-crm-smoke.mjs",
    "test:availability-studio": "node scripts/availability-schedule-smoke.mjs",
    "test:widget-studio": "node scripts/widget-config-smoke.mjs",
    "test:booking-projection": "node scripts/booking-projection-smoke.mjs",
    "typecheck": "tsc -p tsconfig.admin.json --noEmit",
    "typecheck:widget": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-admin --ignore-pattern dist-embed --ignore-pattern dist-approval --ignore-pattern server/dist",
    "css:check": "tailwindcss -i ./src/index.css -o /dev/null --minify"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "3.7.0",
    "@stripe/stripe-js": "7.3.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@tailwindcss/cli": "4.1.10",
    "@tailwindcss/postcss": "4.1.8",
    "@types/node": "24.0.1",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "@vitejs/plugin-react": "4.5.1",
    "autoprefixer": "10.4.21",
    "eslint": "9.28.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.2.0",
    "postcss": "8.5.4",
    "tailwindcss": "4.1.8",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "packageManager": "npm@10.9.2"
}
